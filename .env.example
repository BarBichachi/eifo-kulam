# Copy to .env (gitignored). `npm run configure` fills the generated values for you.

# Apps Script web app (written by `npm run gas:deploy`)
GAS_DEPLOYMENT_ID=
API_URL=

# Shared secret between GitHub Actions / local scripts and Apps Script (generated)
SERVICE_TOKEN=

# Web Push VAPID key pair (generated). The public key is also served to the app via the API.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public site URL (notification links, VAPID subject)
APP_URL=https://barbichachi.github.io/eifo-kulam/

# Optional: lets the in-app "send test notification" button trigger the reminder workflow.
# Fine-grained PAT limited to this repository, permission "Actions: Read and write".
GITHUB_REPO=BarBichachi/eifo-kulam
GITHUB_DISPATCH_TOKEN=

# Local dev without a backend: VITE_API_URL=mock (in .env.local)
