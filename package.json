{
  "name": "eifo-kulam",
  "version": "1.0.0",
  "private": true,
  "description": "Eifo Kulam: weekly team attendance (who is where), mobile PWA",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.backend.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "build:gas": "node scripts/build-gas.ts",
    "clasp": "node scripts/clasp.ts",
    "gas:push": "npm run build:gas && node scripts/clasp.ts push -f",
    "gas:deploy": "npm run gas:push && node scripts/gas-deploy.ts",
    "configure": "node scripts/configure.ts",
    "roster": "node scripts/roster-import.ts",
    "reminder": "node scripts/reminder.ts",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "web-push": "^4.0.0"
  }
}
